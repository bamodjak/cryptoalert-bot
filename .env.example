ADMIN_IDS=123456789            # comma-separated numeric Telegram user IDs
OWNER_ID=123456789              # owner gets free Premium; set to your own Telegram user ID
SUPPORT_CONTACT=@M_4_iQ
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgresql+asyncpg://bot:change-me-long-random@db:5432/bot
